<sdf version="1.6">
  <world name="lab">

    <plugin name="gazebo_ros_init" filename="libgazebo_ros_init.so"/>
    <plugin name="gazebo_ros_factory" filename="libgazebo_ros_factory.so"/>

    <include>
      <uri>model://sun</uri>
    </include>

    <include>
      <uri>model://ground_plane</uri>
    </include>



    <model name="table_mark_red">
        <static>true</static>
          <pose>0.8 0.35 0.3 0 0 0</pose>
        <link name="link">

       <visual name="visual">
       <geometry>
        <cylinder>
          <radius>0.15</radius>
          <length>0.001</length>
        </cylinder>
       </geometry>

       <material>
        <ambient>1 0 0 0.3</ambient>
        <diffuse>1 0 0 0.3</diffuse>
       </material>
       </visual>

       </link>
    </model>
    
    <model name="table_mark_blue">
     <static>true</static>
     <pose>0.8 -0.38 0.3 0 0 0</pose>

     <link name="link">

       <visual name="visual">
      <geometry>
        <cylinder>
          <radius>0.15</radius>
          <length>0.001</length>
        </cylinder>
      </geometry>

      <material>
        <ambient>0 0 1 0.3</ambient>
        <diffuse>0 0 1 0.3</diffuse>
      </material>
    </visual>

  </link>
</model>


    <!-- Table -->
    <model name="table">
      <static>true</static>
      <pose>0.8 0 0.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.8 1.2 0.6</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.6 1.2 0.6</size></box>
          </geometry>
          <material>
            <ambient>0.6 0.4 0.3 1</ambient>
            <diffuse>0.6 0.4 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Cube Left -->
    <model name="cube_left">
      <pose>0.71 0.15 0.75 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.1</mass></inertial>
        <collision name="collision">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Cube Right -->
    <model name="cube_right">
      <pose>0.8 -0.15 0.75 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.1</mass></inertial>
        <collision name="collision">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <material>
            <ambient>0 0 1 1</ambient>
            <diffuse>0 0 1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>

