<sdf version="1.6">
  <world name="lab">

    <plugin name="gazebo_ros_init" filename="libgazebo_ros_init.so"/>
    <plugin name="gazebo_ros_factory" filename="libgazebo_ros_factory.so"/>
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <update_rate>10.0</update_rate>
    </plugin>

    <plugin name="grasp_welder" filename="libgrasp_welder.so">
      <ros>
        <namespace>/ur_lab</namespace>
      </ros>
    </plugin>

    <!-- stiffer constraint solving => stable pinched grasps -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <ode>
        <solver>
          <iterations>150</iterations>
          <sor>1.4</sor>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
        </constraints>
      </ode>
    </physics>

    <include>
      <uri>model://sun</uri>
    </include>

    <include>
      <uri>model://ground_plane</uri>
    </include>



    <model name="table_mark_red">
        <static>true</static>
          <pose>0.8 0.35 0.3 0 0 0</pose>
        <link name="link">

       <visual name="visual">
       <geometry>
        <cylinder>
          <radius>0.15</radius>
          <length>0.001</length>
        </cylinder>
       </geometry>

       <material>
        <ambient>1 0 0 0.3</ambient>
        <diffuse>1 0 0 0.3</diffuse>
       </material>
       </visual>

       </link>
    </model>
    
    <model name="table_mark_blue">
     <static>true</static>
     <pose>0.8 -0.38 0.3 0 0 0</pose>

     <link name="link">

       <visual name="visual">
      <geometry>
        <cylinder>
          <radius>0.15</radius>
          <length>0.001</length>
        </cylinder>
      </geometry>

      <material>
        <ambient>0 0 1 0.3</ambient>
        <diffuse>0 0 1 0.3</diffuse>
      </material>
    </visual>

  </link>
</model>


    <!-- Table -->
    <model name="table">
      <static>true</static>
      <pose>0.8 0 0.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.8 1.2 0.6</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.6 1.2 0.6</size></box>
          </geometry>
          <material>
            <ambient>0.6 0.4 0.3 1</ambient>
            <diffuse>0.6 0.4 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Loose cubes removed: pick_cube spawns its own single cube -->
    <!--
    <model name="cube_left">
      <pose>0.71 0.15 0.75 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.1</mass></inertial>
        <collision name="collision">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="cube_right">
      <pose>0.8 -0.15 0.75 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.1</mass></inertial>
        <collision name="collision">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <material>
            <ambient>0 0 1 1</ambient>
            <diffuse>0 0 1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    -->

  </world>
</sdf>

